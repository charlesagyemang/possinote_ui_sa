# API Configuration
NEXT_PUBLIC_API_URL=https://notifyapi.possitech.net/api/v1
NEXT_PUBLIC_ADMIN_BASE_URL=http://localhost:2025/admin/api/v1
NEXT_PUBLIC_POSSINOTE_API_KEY=your_possinote_api_key_here

# Paystack Configuration
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

# Credit Pricing (per credit in Ghanaian Cedi)
# ₵7 = 100 SMS credits (0.07 per credit)
NEXT_PUBLIC_SMS_CREDIT_RATE=0.07

# ₵2 = 100 Email credits (0.02 per credit)
NEXT_PUBLIC_EMAIL_CREDIT_RATE=0.02

# ₵10 = 100 General credits (0.10 per credit)
NEXT_PUBLIC_GENERAL_CREDIT_RATE=0.10

# Plan Pricing (in Ghanaian Cedi)
NEXT_PUBLIC_STARTER_PLAN_PRICE=99
NEXT_PUBLIC_BUSINESS_PLAN_PRICE=399
NEXT_PUBLIC_ENTERPRISE_PLAN_PRICE=799

# Bundle Configuration (comma-separated values: name,sms,email,description,color,popular)
# Format: "name|sms|email|description|color|popular"
NEXT_PUBLIC_BUNDLE_STARTER=Starter Bundle|1000|1000|Perfect for small businesses|from-blue-500 to-purple-600|false
NEXT_PUBLIC_BUNDLE_BUSINESS=Business Bundle|5000|5000|Great for growing businesses|from-purple-500 to-pink-600|true
NEXT_PUBLIC_BUNDLE_ENTERPRISE=Enterprise Bundle|10000|10000|For large-scale operations|from-green-500 to-emerald-600|false

# Contact Information
NEXT_PUBLIC_SALES_EMAIL=sales@possitech.net
NEXT_PUBLIC_SALES_PHONE_NUMBER=+233244123456

# SMS Configuration
NEXT_PUBLIC_SMS_SENDER_ID=POSSI

# Active Promo Configuration
NEXT_PUBLIC_ACTIVE_PROMO_NAME=Black Friday Special
NEXT_PUBLIC_ACTIVE_PROMO_SMS_CREDITS=1000
NEXT_PUBLIC_ACTIVE_PROMO_EMAIL_CREDITS=500
NEXT_PUBLIC_ACTIVE_PROMO_DESCRIPTION=Special offer - 1000 SMS + 500 Email credits
NEXT_PUBLIC_ACTIVE_PROMO_VALID_UNTIL=2024-12-31
NEXT_PUBLIC_ACTIVE_PROMO_ACTIVE=true
NEXT_PUBLIC_ACTIVE_PROMO_BACKGROUND_COLOR=from-purple-500 to-pink-600
NEXT_PUBLIC_ACTIVE_PROMO_ICON_COLOR=purple-400

# Promo Access Token (for URL authentication)
NEXT_PUBLIC_PROMO_ACCESS_TOKEN=301040
